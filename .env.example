# ---- PrometheusAI configuration -------------------------------------------------
# Copy to .env and edit. Never commit .env.

PROMETHEUS_AI_ENV=dev

# Storage. Leave DATABASE_URL empty to use the in-memory store (dev/test only).
# In-memory state is lost on restart and does not exercise crash-resume.
PROMETHEUS_AI_DATABASE_URL=
PROMETHEUS_AI_APPROVER_TOKEN=dev-approval-token
# Required outside dev/test/local. Alertmanager sends it as a bearer token.
PROMETHEUS_AI_WEBHOOK_TOKEN=

# HTTP hardening. Disable docs in any shared environment.
PROMETHEUS_AI_ENABLE_DOCS=true
PROMETHEUS_AI_MAX_REQUEST_BYTES=1000000
PROMETHEUS_AI_AUDIT_INPUT_REDACTION=true

# Observability sources
PROMETHEUS_AI_PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_AI_LOKI_URL=http://localhost:3100
PROMETHEUS_AI_DEMO_NAMESPACE=demo

# Models: fake | ollama | bedrock
PROMETHEUS_AI_MODEL_BACKEND=fake
PROMETHEUS_AI_OLLAMA_URL=http://localhost:11434
PROMETHEUS_AI_OLLAMA_MODEL=qwen2.5:7b-instruct
PROMETHEUS_AI_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
PROMETHEUS_AI_BEDROCK_REGION=us-east-1
PROMETHEUS_AI_COST_CAP_USD=15.0

# Safety limits
PROMETHEUS_AI_MAX_TOOL_CALLS=6
PROMETHEUS_AI_MAX_REHYPOTHESIS=2
PROMETHEUS_AI_MAX_WRITES_PER_HOUR=3
PROMETHEUS_AI_NODE_TIMEOUT_SECONDS=60
PROMETHEUS_AI_APPROVAL_TTL_MINUTES=30
PROMETHEUS_AI_KILL_SWITCH=false
PROMETHEUS_AI_DRY_RUN=true

# Policy service (separate process, holds the only write credential)
PROMETHEUS_AI_POLICY_MODE=inprocess        # inprocess | http
PROMETHEUS_AI_POLICY_URL=http://localhost:8081
PROMETHEUS_AI_POLICY_TOKEN=dev-policy-token
# auto | fake | kubectl. `auto` uses the fake inventory only with the fake model.
PROMETHEUS_AI_INVENTORY_BACKEND=auto
